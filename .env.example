# docker compose 用の設定。このファイルを .env にコピーして値を埋める。
# cp .env.example .env

# --- GitHub 認証 (必須) ---
# pat = Personal Access Token をそのまま使う
# app = GitHub App の installation access token を都度発行する
GITHUB_AUTH_MODE=pat

# GITHUB_AUTH_MODE=pat のとき必須。repo / PR コメント権限が必要。
GH_TOKEN=

# GITHUB_AUTH_MODE=app のとき必須。
# App に必要な権限: Contents=Read / Pull requests=Read and write / Metadata=Read
# 秘密鍵は ./secrets/ に置く (コンテナ内では /run/secrets/ に read-only でマウントされる)。
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# 省略すると REVIEW_ORG の installation を API で自動解決する。
GITHUB_APP_INSTALLATION_ID=

# --- Codex 認証 (必須) ---
CODEX_API_KEY=

# --- レビュー設定 (任意) ---
REVIEW_ORG=your-org
REVIEW_MODEL=gpt-5.6-terra

# ホスト側の公開ポート (既定 8080)
REVIEW_PORT=8080
