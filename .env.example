# docker compose 用の設定。このファイルを .env にコピーして値を埋める。
# cp .env.example .env

# --- GitHub 認証 (必須) ---
# pat = Personal Access Token をそのまま使う
# app = GitHub App の installation access token を都度発行する
GITHUB_AUTH_MODE=pat

# GITHUB_AUTH_MODE=pat のとき必須。repo / PR コメント権限が必要。
GH_TOKEN=

# GITHUB_AUTH_MODE=app のとき必須。
# App に必要な権限: Contents=Read / Pull requests=Read and write / Metadata=Read
# 秘密鍵は ./secrets/ に置く (コンテナ内では /run/secrets/ に read-only でマウントされる)。
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# 省略すると REVIEW_ORG の installation を API で自動解決する。
GITHUB_APP_INSTALLATION_ID=

# --- Codex 認証 (必須) ---
CODEX_API_KEY=

# --- レビュー対象の GitHub Organization (必須) ---
REVIEW_ORG=

# --- レビュー設定 (任意) ---
REVIEW_MODEL=gpt-5.6-terra
# 推論の深さ (minimal / low / medium / high)。空にするとモデル既定に従う。
REVIEW_REASONING_EFFORT=medium

# codex 1 回あたりの制限時間 (秒)。単一ワーカーのため、固まるとキュー全体が
# 止まる。0 で無制限。
REVIEW_TIMEOUT=3600

# codex の生ログ (err) の保持日数。レビュー本文と詳細は DB にあるので、
# 消えても画面表示は変わらない。0 で削除しない。
REVIEW_STDERR_RETENTION_DAYS=30

# 画面上部に出す説明文 (任意)。空なら説明欄そのものが表示されない。
# 空行 (\n\n) で段落、行頭 "- " で箇条書き、[表示文字列](URL) と裸の URL がリンクになる。
#REVIEW_DESCRIPTION=Codex による PR の自動レビューを実行します。\n\n- 使い方: [説明ページ](https://example.com/codex-review)\n- 不具合の報告: [#codex-review](https://example.com/chat)

# ホスト側の公開ポート (既定 8080)
REVIEW_PORT=8080
