// フロントエンド (webreview/static) の型検査だけを行う設定。
// ビルドはせず (noEmit)、配信されるのは app.js そのもの。
//   npx tsc --noEmit
// VS Code はこの設定を自動で読むので、エディタ上では何も入れずに検査が効く。
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // catch の変数は unknown ではなく any 扱いにする。投げているのは fetchJSON の
    // Error だけなので、全箇所に絞り込みを書く意味がない。
    "useUnknownInCatchVariables": false,
    // Node の型定義 (@types/*) は一切使わない。ブラウザで動くコードなので
    // setTimeout などは DOM 側の定義を引く。
    "types": []
  },
  "include": ["webreview/static/**/*.js", "webreview/static/**/*.d.ts"]
}
